# FRONTEND config (Next.js). Optional: the defaults work for local development.
# Copy to frontend/.env.local if you need to change them. Never put API keys here:
# anything starting with NEXT_PUBLIC_ is sent to the browser.

# Where Next.js proxies /api requests (the backend).
# API_ORIGIN=http://127.0.0.1:4000

# WebSocket endpoint seen by the browser. Default: ws(s)://<current host>:4000
# NEXT_PUBLIC_WS_URL=wss://copilot.example.com
