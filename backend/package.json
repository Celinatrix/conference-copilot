    "@fastify/websocket": "^11.3.7",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
