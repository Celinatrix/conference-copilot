# Copy to .env (same folder) and fill in. Never commit .env. Keys stay on the server only.

# --- Speech-to-Text: Deepgram (https://console.deepgram.com) ---
DEEPGRAM_API_KEY=
# nova-3 supports language=multi (automatic detection / code-switching) for a limited set of languages.
# If your source language is not supported by nova-3, set the conference's input language explicitly
# and/or switch the model (e.g. nova-2) here.
DEEPGRAM_MODEL=nova-3
# Used only for the cost estimate shown in the UI. Check your Deepgram plan's streaming price.
DEEPGRAM_USD_PER_MIN=0.0092

# --- Translation: Anthropic Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-haiku-5-5
TRANSLATION_INPUT_USD_PER_MTOK=0.10
TRANSLATION_OUTPUT_USD_PER_MTOK=0.50

# --- Suggested answers (Smart Response) ---
ANSWER_MODEL=claude-sonnet-5-5
ANSWER_INPUT_USD_PER_MTOK=2
ANSWER_OUTPUT_USD_PER_MTOK=10
ANSWER_CACHE_READ_USD_PER_MTOK=0.2
ANSWER_CACHE_WRITE_USD_PER_MTOK=2.5
# Segments recognised with confidence below this are flagged as "not heard clearly".
LOW_CONFIDENCE_THRESHOLD=0.75

# --- AI cost controls (USD; 0 disables a cap) ---
# Hard cap on all paid AI (STT, translation, question detection, answers) per conference. New sessions,
# answers and retranslations are refused past it; a session already running keeps translating.
AI_CONFERENCE_CAP_USD=10
# Hard cap on all paid AI per workspace over the last 24 hours.
AI_WORKSPACE_DAILY_CAP_USD=25
# Auto-suggested answers stop (and wait for a click) once a conference's answer spend reaches this.
ANSWER_AUTO_BUDGET_USD=1
# Per-user request limits for endpoints that start paid AI calls.
AI_QUESTIONS_PER_MINUTE=10
AI_RETRANSLATE_PER_MINUTE=15

# --- Server ---
PORT=4000
HOST=127.0.0.1
# Browser origins allowed to call the API / open the live WebSocket (comma separated).
ALLOWED_ORIGINS=http://localhost:3000
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
# Self-registration. Off: after the first (owner) account, people join only through invite links created in
# Settings → Thành viên & lời mời. Turn on only for a closed network you trust.
ALLOW_SIGNUP=false
# Registration attempts allowed per IP per hour.
REGISTER_PER_HOUR=5
# Proxies allowed to set X-Forwarded-For (Fastify trustProxy syntax): "loopback" = the Next.js proxy on this
# machine. Use your reverse proxy's address in production, or "false" when nothing sits in front.
TRUST_PROXY=loopback

# --- Database ---
# Leave DATABASE_URL empty to use embedded PGlite (data stored in ./data/pglite).
# For production use a real PostgreSQL 16+: postgres://user:pass@host:5432/copilot
DATABASE_URL=
# PGLITE_DIR=./data/pglite

# LOG_LEVEL=info

# --- Web (Next.js) ---
# Next.js only reads env files inside web/, so put these two in web/.env.local (not here) if you need them.
# The defaults work for local development.
# API_ORIGIN=http://127.0.0.1:4000              (where Next.js proxies /api requests)
# NEXT_PUBLIC_WS_URL=wss://copilot.example.com  (WebSocket endpoint seen by the browser; default ws(s)://<host>:4000)
